  "id": "neon",
  "name": "Neon",
  "description": "Vibrant cyan and magenta glow with an expressive colour shift on the active word.",
  "aliases": [
    "neon-glow"
  ],
  "typography": {
    "fontFamily": "Noto Sans",
    "fontSizePx": 78,
    "fontWeight": 700,
    "lineSpacing": 1.4,
    "textCase": "none",
    "maxWordsPerCue": 4,
    "maxCharsPerLine": 20,
    "maxLines": 2
  },
  "colors": {
    "fill": "#FFFFFF",
    "stroke": {
      "color": "#FF2BD6",
      "widthRatio": 0.05
    },
    "shadow": {
      "color": "#00E5FF",
      "blur": 16,
      "offsetX": 0,
      "offsetY": 0
    }
  },
  "activeWord": {
    "color": "#00E5FF",
    "scale": 1.08,
    "fontWeight": 700
  },
  "motionDefault": {
    "animation": "neon-pulse",
    "intensity": "expressive"
  }
