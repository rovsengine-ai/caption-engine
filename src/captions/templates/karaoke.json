  "id": "karaoke",
  "name": "Karaoke",
  "description": "Word-by-word active pill behind the word being spoken.",
  "aliases": [
    "karaoke-pill"
  ],
  "typography": {
    "fontFamily": "Noto Sans",
    "fontSizePx": 66,
    "fontWeight": 700,
    "lineSpacing": 1.42,
    "textCase": "none",
