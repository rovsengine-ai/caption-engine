      "color": "#00120A",
      "widthRatio": 0.04
    },
    "shadow": {
      "color": "#000000",
      "blur": 4,
      "offsetX": 0,
      "offsetY": 2
    }
  },
  "activeWord": {
    "color": "#102010",
    "scale": 1.04,
    "fontWeight": 700,
    "backgroundBox": {
      "color": "#00E676",
      "paddingPx": 10,
      "borderRadiusPx": 14
    }
  },
  "motionDefault": {
    "animation": "karaoke-sweep",
    "intensity": "subtle"
  }
