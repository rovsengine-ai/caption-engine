  "id": "creator-highlight",
  "name": "Creator Highlight",
  "description": "Social reel style with a 1.15× active-word zoom and a brand-colour highlight.",
  "aliases": [
    "creator"
  ],
  "typography": {
    "fontFamily": "Noto Sans",
    "fontSizePx": 76,
    "fontWeight": 700,
    "lineSpacing": 1.38,
    "textCase": "none",
    "maxWordsPerCue": 4,
    "maxCharsPerLine": 20,
    "maxLines": 2
  },
  "colors": {
    "fill": "#FFFFFF",
    "stroke": {
      "color": "#0A0014",
      "widthRatio": 0.07
    },
    "shadow": {
      "color": "#000000",
      "blur": 8,
      "offsetX": 0,
      "offsetY": 4
    }
  },
  "activeWord": {
    "color": "#7C4DFF",
    "scale": 1.15,
    "fontWeight": 700
  },
  "motionDefault": {
    "animation": "dynamic-word-focus",
    "intensity": "expressive"
  }
}
