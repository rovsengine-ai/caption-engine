# Primary ASR — word-level timestamps + Indic code-switch handling
ELEVENLABS_API_KEY=

# Backup provider (Telugu + Kannada added Jan 2026)
DEEPGRAM_API_KEY=

# Benchmarking / India data-residency ONLY.
# Cannot back word-timed captions: REST returns sentence-level timestamps.
SARVAM_API_KEY=

# Only needed for --clips
ANTHROPIC_API_KEY=

ASR_PROVIDER=elevenlabs

# Optional overrides
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# FONT_DIR=/path/to/fonts
