# Copy this file to .env and fill in the values.
#
#   macOS / Linux     cp .env.example .env
#   Windows (PS)      Copy-Item .env.example .env
#
# .env is gitignored. Never commit it. Real environment variables always win
# over anything in this file, so `export KEY=...` overrides it for one shell.

# Primary ASR — word-level timestamps + Indic code-switch handling.
ELEVENLABS_API_KEY=

# Hinglish transliteration (used by `npm run caption:hinglish`).
# Also usable for accuracy benchmarking / India data residency.
# Cannot back word-timed captions: its REST API returns sentence-level timings.
SARVAM_API_KEY=

ASR_PROVIDER=elevenlabs

# Extra font directories, in addition to the vendored set in assets/fonts/.
# Leave EMPTY unless you have a reason — the bundled Noto fonts are detected
# automatically after `npm run build`, on every platform.
# Separate multiple directories with the platform PATH separator:
#   Windows        FONT_DIR=C:\fonts;D:\more-fonts
#   macOS/Linux    FONT_DIR=/usr/share/fonts:/home/me/.fonts
FONT_DIR=

# Where finished files are written. Relative paths are resolved from the
# project root. Created automatically.
OUTPUT_DIR=outputs

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Backup ASR provider (Telugu + Kannada added Jan 2026).
DEEPGRAM_API_KEY=

# Only needed for --clips.
ANTHROPIC_API_KEY=

# Explicit binary paths, if ffmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
